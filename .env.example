# Copy this file to ".env" and fill in the values from your Firebase project
# (Firebase Console > Project Settings > General > Your apps > SDK setup and configuration).
# Until these are filled in, the app keeps working the old way — orders and
# products are only saved on the device that created them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Copy these from your EmailJS account (emailjs.com > Email Services / Email
# Templates / Account > General). Until these are filled in, order emails are
# just skipped — checkout still works.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
