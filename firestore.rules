rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the email(s) of the Firebase Auth account(s) created for
    // the admin panel (Authentication > Users in the Firebase console). Only
    // these accounts may create/edit/delete products or manage orders.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['mohammedgh.basha.k@gmail.com'];
    }

    function isValidStockDecrement() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['stockKg', 'available']) &&
        after.stockKg is number && after.stockKg >= 0 && after.stockKg <= before.stockKg &&
        after.available == (after.stockKg > 0);
    }

    function isValidNewOrder(orderId) {
      let d = request.resource.data;
      return d.id == orderId &&
        d.status == 'Pending' &&
        d.items is list && d.items.size() > 0 &&
        d.total is number && d.total > 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Anonymous customers may only decrement stockKg (and keep `available`
      // consistent with it) as part of placing an order — see reserveStock()
      // in ProductContext.tsx. Every other field, and any increase in stock,
      // requires an admin.
      allow update: if isAdmin() || isValidStockDecrement();
    }

    match /orders/{orderId} {
      // Order tracking looks up an order by its ID with no login (see
      // Tracking.tsx) — this keeps that working, but means anyone who knows
      // an order ID can read its contents. Locking that down further needs a
      // real "my orders" auth flow, which is out of scope for this pass.
      allow read: if true;

      // Anonymous customers create their own order at checkout, but the
      // order must start out clean: correct id, "Pending" status, and a
      // non-empty, positive-total cart.
      allow create: if isValidNewOrder(orderId);

      // Only the admin panel may change status or remove an order.
      allow update, delete: if isAdmin();
    }
  }
}
